---
import Base from '../layouts/Base.astro';
import { t, tHtml } from '../i18n/ui';

const locale = (Astro.currentLocale ?? 'en') as 'en' | 'zh';
const base = import.meta.env.BASE_URL;
const lBase = locale === 'zh' ? '/zh' : '';
---
<Base title={t(locale, 'about.title')} description={t(locale, 'about.description')}>
  <section class="hero">
    <span class="eyebrow">{locale === 'zh' ? <span class="cjk">关于</span> : 'About'}</span>
    <h1>{t(locale, 'about.title')}</h1>
    <p class="lede">{t(locale, 'about.lede')}</p>
  </section>
  <section class="prose">
    <p set:html={tHtml(locale, 'about.intro', { blog: `${lBase}${base}blog`, products: `${lBase}${base}products`, news: `${lBase}${base}news` })} />
    <p set:html={tHtml(locale, 'about.chat')} />
  </section>
</Base>
