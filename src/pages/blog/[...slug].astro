---
import { getCollection } from 'astro:content';
import { Copy, ExternalLink, List, X } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import PostCitation from '../../components/PostCitation.astro';
import { t, formatDate } from '../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.locale === 'en');
  return posts.map((post) => {
    const parts = post.slug.split('/');
    const slug = parts.slice(1).join('/');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const locale = (post.data.locale ?? 'en') as 'en' | 'zh';
const { Content, headings } = await post.render();
const hasRefs = post.body.includes('<li id="ref-1"');
const tocItems = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ depth: h.depth, slug: h.slug, text: h.text }));
if (hasRefs) {
  tocItems.push({ depth: 2, slug: 'references', text: locale === 'zh' ? '参考文献' : 'References' });
}
tocItems.push({ depth: 2, slug: 'citation', text: locale === 'zh' ? '引用本文' : 'Citation' });
const hasToc = tocItems.length > 2;
const tocTitle = locale === 'zh' ? '目录' : 'Contents';
const labels = {
  view: locale === 'zh' ? '在列表中查看' : 'View in list',
  open: locale === 'zh' ? '打开链接' : 'Open link',
  openHint: locale === 'zh' ? '在新标签页打开第一个来源链接' : 'Open the first source link in a new tab',
  copy: locale === 'zh' ? '复制' : 'Copy',
  copied: locale === 'zh' ? '已复制' : 'Copied',
  back: locale === 'zh' ? '↩ 返回阅读位置' : '↩ Back to reading',
  close: locale === 'zh' ? '关闭' : 'Close',
};
const base = import.meta.env.BASE_URL;
const lBase = locale === "zh" ? "/zh" : "";
---

<Base title={`${post.data.title} · ${t(locale, 'site.brand')}`} description={post.data.description}>
  <article class="hero">
    <h1>{post.data.title}</h1>
    <p class="meta">{formatDate(locale, post.data.pubDate)}</p>
    {post.data.tags.length > 0 && (
      <div class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
    )}
  </article>
  {hasToc ? (
    <div class="post-grid">
      <aside class="toc" aria-label={tocTitle}>
        <nav>
          <ul>
            {tocItems.map((h) => (
              <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </nav>
      </aside>
      <div class="post-main">
        <details class="toc-mobile">
          <summary>{tocTitle}</summary>
          <ul>
            {tocItems.map((h) => (
              <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ul>
        </details>
        <div class="prose">
          <Content />
          <PostCitation post={post} />
        </div>
        <a class="back-link" href={`${lBase}${base}blog`}>{t(locale, 'section.backBlog')}</a>
      </div>
    </div>
  ) : (
    <>
      <div class="prose">
        <Content />
        <PostCitation post={post} />
      </div>
      <a class="back-link" href={`${lBase}${base}blog`}>{t(locale, 'section.backBlog')}</a>
    </>
  )}
  {hasRefs && (
    <>
      <div class="ref-popup" id="ref-popup" hidden>
        <div class="ref-popup-body"></div>
        <div class="ref-popup-actions">
          <button type="button" class="ref-popup-view" title={labels.view}><List size={14} aria-hidden="true" />{labels.view}</button>
          <a class="ref-popup-open" target="_blank" rel="noopener noreferrer" title={labels.openHint} hidden><ExternalLink size={14} aria-hidden="true" />{labels.open}</a>
          <button type="button" class="ref-popup-copy" title={labels.copy} data-label={labels.copy} data-copied={labels.copied}><Copy size={14} aria-hidden="true" /><span class="ref-popup-copy-label" aria-live="polite">{labels.copy}</span></button>
          <button type="button" class="ref-popup-close" aria-label={labels.close} title={labels.close}><X size={16} aria-hidden="true" /></button>
        </div>
      </div>
      <button type="button" class="back-to-reading" id="back-to-reading" hidden>{labels.back}</button>
    </>
  )}
</Base>

<script>
  const prose = document.querySelector('.prose');

  // Locate the references list (a <details> holding li[id^=ref-]) and give it
  // an anchor id so the TOC's "References" entry has somewhere to point.
  let refsDetails = null;
  if (prose) {
    for (const d of prose.querySelectorAll('details')) {
      if (d.querySelector('li[id^="ref-"]')) { refsDetails = d; break; }
    }
    if (refsDetails) refsDetails.id = 'references';
  }

  // Sidebar scrollspy
  const toc = document.querySelector('.toc');
  const links = document.querySelectorAll('.toc a');
  if (toc && links.length > 0) {
    const byHeading = new Map();
    links.forEach((a) => {
      const id = decodeURIComponent((a.getAttribute('href') || '').slice(1));
      const el = document.getElementById(id);
      if (el) byHeading.set(el, a);
    });
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.remove('active'));
            const link = byHeading.get(entry.target);
            if (link) {
              link.classList.add('active');
              if (!toc.clientHeight) continue;

              // scrollIntoView can pan the pinch-zoomed viewport and interrupt
              // an anchor jump. Keep automatic scrolling inside the sidebar.
              const top = toc.getBoundingClientRect().top + toc.clientTop;
              const bottom = top + toc.clientHeight;
              const rect = link.getBoundingClientRect();
              if (rect.top < top) {
                toc.scrollTop += rect.top - top;
              } else if (rect.bottom > bottom) {
                toc.scrollTop += rect.bottom - bottom;
              }
            }
          }
        }
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );
    byHeading.forEach((_, el) => observer.observe(el));
  }

  // Citation popup + back-to-reading
  const popup = document.getElementById('ref-popup');
  if (prose && popup && refsDetails) {
    const popupBody = popup.querySelector('.ref-popup-body');
    const viewBtn = popup.querySelector('.ref-popup-view');
    const openLink = popup.querySelector('.ref-popup-open');
    const copyBtn = popup.querySelector('.ref-popup-copy');
    const copyLabel = popup.querySelector('.ref-popup-copy-label');
    const closeBtn = popup.querySelector('.ref-popup-close');
    const backBtn = document.getElementById('back-to-reading');
    let currentLi = null;
    let returnY = null;

    const hidePopup = () => { popup.hidden = true; };

    // A citation click opens the popup instead of jumping to the list.
    prose.querySelectorAll('a[href^="#ref-"]').forEach((a) => {
      a.addEventListener('click', (e) => {
        const li = document.getElementById((a.getAttribute('href') || '').slice(1));
        if (!li) return;
        e.preventDefault();
        currentLi = li;
        popupBody.innerHTML = li.innerHTML;
        // Use the first web source for the shortcut; keep every source clickable.
        const sourceLinks = Array.from(popupBody.querySelectorAll('a[href]'))
          .filter((link) => link.protocol === 'https:' || link.protocol === 'http:');
        sourceLinks.forEach((link) => {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        });
        openLink.hidden = sourceLinks.length === 0;
        if (sourceLinks.length) openLink.href = sourceLinks[0].href;
        else openLink.removeAttribute('href');
        copyLabel.textContent = copyBtn.dataset.label;
        popup.hidden = false;
        const r = a.getBoundingClientRect();
        const pw = Math.min(430, window.innerWidth - 24);
        popup.style.width = pw + 'px';
        popup.style.left = Math.min(Math.max(12, r.left), window.innerWidth - pw - 12) + 'px';
        const ph = popup.offsetHeight;
        let top = r.bottom + 10;
        if (top + ph > window.innerHeight - 12) top = Math.max(12, r.top - ph - 10);
        popup.style.top = top + 'px';
      });
    });

    viewBtn.addEventListener('click', () => {
      if (!currentLi) return;
      hidePopup();
      returnY = window.scrollY;
      refsDetails.open = true;
      currentLi.scrollIntoView();
      currentLi.classList.remove('ref-flash');
      void currentLi.offsetWidth;
      currentLi.classList.add('ref-flash');
      backBtn.hidden = false;
    });

    // navigator.clipboard only exists on secure origins (https / localhost);
    // fall back to a hidden textarea + execCommand elsewhere (e.g. LAN preview).
    const copyText = async (text) => {
      if (window.isSecureContext && navigator.clipboard) {
        await navigator.clipboard.writeText(text);
        return;
      }
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      if (!ok) throw new Error('execCommand copy failed');
    };

    copyBtn.addEventListener('click', async () => {
      if (!currentLi) return;
      let text = currentLi.textContent.trim().replace(/\s+/g, ' ');
      const srcLink = currentLi.querySelector('a[href]');
      if (srcLink) text += ' — ' + srcLink.href;
      try {
        await copyText(text);
        copyLabel.textContent = copyBtn.dataset.copied;
      } catch (e) {
        copyLabel.textContent = '✗';
      }
    });

    closeBtn.addEventListener('click', hidePopup);
    document.addEventListener('click', (e) => {
      const t = e.target;
      if (!popup.hidden && t instanceof Element && !popup.contains(t) && !t.closest('a[href^="#ref-"]')) hidePopup();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hidePopup(); });

    backBtn.addEventListener('click', () => {
      if (returnY !== null) window.scrollTo({ top: returnY });
      backBtn.hidden = true;
    });

    // TOC "References" links must unfold the list before the browser scrolls to it.
    document.querySelectorAll('a[href="#references"]').forEach((a) => {
      a.addEventListener('click', () => { refsDetails.open = true; });
    });
  }
</script>
