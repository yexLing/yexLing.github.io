---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t, formatDate } from '../i18n/ui';

const locale = (Astro.currentLocale ?? 'en') as 'en' | 'zh';
const base = import.meta.env.BASE_URL;
const lBase = locale === 'zh' ? '/zh' : '';

const news = (await getCollection('news', ({ data }) => data.locale === locale))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function cleanSlug(slug: string): string {
  const i = slug.indexOf('/');
  return i >= 0 ? slug.slice(i + 1) : slug;
}
---

<Base title={`${t(locale, 'news.title')} · ${t(locale, 'site.brand')}`} description={t(locale, 'news.description')}>
  <section class="hero">
    <span class="eyebrow">{locale === "zh" ? <span class="cjk">随笔</span> : "Notes"}</span>
    <h1>{t(locale, 'news.title')}</h1>
    <p class="lede">{t(locale, 'news.description')}</p>
  </section>
  <section>
    {news.map((item) => (
      <a class="card" href={`${lBase}${base}news/${cleanSlug(item.slug)}`}>
        <h3>{item.data.title}</h3>
        <p class="meta">{formatDate(locale, item.data.date)}</p>
      </a>
    ))}
    {news.length === 0 && <p class="meta" set:html={t(locale, 'news.empty')} />}
  </section>
</Base>
