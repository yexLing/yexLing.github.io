---
const target = '/terminalboard/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>terminalboard has moved</title>
  </head>
  <body>
    <p>terminalboard has moved to <a href={target}>/terminalboard/</a>.</p>
  </body>
</html>
