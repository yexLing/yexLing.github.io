---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';

const locale = (Astro.currentLocale ?? 'en') as 'en' | 'zh';
const base = import.meta.env.BASE_URL;
const lBase = locale === 'zh' ? '/zh' : '';

const products = locale === 'zh'
  ? [
      {
        name: 'Pinaday',
        href: `${base}pinaday`,
        image: '/images/products/pinaday/icon.png',
        media: 'icon',
        kicker: 'Daily notes',
        description: '一款安静的 macOS 日记便签。每天一张笔记，用可旋转日期拨盘在时间里移动。',
      },
      {
        name: 'terminalboard',
        href: `${lBase}${base}terminalboard`,
        image: '/images/products/terminalboard/demo.gif',
        media: 'screenshot',
        kicker: 'TensorBoard in your terminal',
        description: '在终端里查看 TensorBoard 训练曲线，并用内置助手分析实验。',
      },
    ]
  : [
      {
        name: 'Pinaday',
        href: `${base}pinaday`,
        image: '/images/products/pinaday/icon.png',
        media: 'icon',
        kicker: 'Daily notes',
        description: 'A calm, local-first daily notes app for macOS, built around one note for every day.',
      },
      {
        name: 'terminalboard',
        href: `${base}terminalboard`,
        image: '/images/products/terminalboard/demo.gif',
        media: 'screenshot',
        kicker: 'TensorBoard in your terminal',
        description: 'A terminal-native TensorBoard viewer with a small AI assistant for training runs.',
      },
    ];
---

<Base title={`${t(locale, 'products.title')} · ${t(locale, 'site.brand')}`} description={t(locale, 'products.description')}>
  <section class="hero">
    <span class="eyebrow">{locale === 'zh' ? <span class="cjk">产品</span> : 'Products'}</span>
    <h1>{t(locale, 'products.title')}</h1>
    <p class="lede">{t(locale, 'products.description')}</p>
  </section>

  <section class="product-index-grid" aria-label={t(locale, 'products.title')}>
    {products.map((product) => (
      <a class="product-index-card" href={product.href}>
        <div class={`product-index-media product-index-media-${product.media}`}>
          <img src={product.image} alt="" loading="lazy" />
        </div>
        <div>
          <p class="product-kicker">{product.kicker}</p>
          <h2>{product.name}</h2>
          <p>{product.description}</p>
        </div>
      </a>
    ))}
  </section>
</Base>
